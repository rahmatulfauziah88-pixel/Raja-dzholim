{
  "name": "video-mihnah-remotion",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "remotion studio",
    "typecheck": "tsc --noEmit",
    "check:assets": "node scripts/check-assets.mjs",
    "analyze-audio": "node scripts/analyze-audio.mjs",
    "export-timing": "tsx scripts/export-timing.ts",
    "check:images": "node scripts/check-assets.mjs --images-only",
    "render": "npm run typecheck && npm run check:assets && npm run analyze-audio && remotion render src/index.ts RajaDzolim out/raja-dzolim.mp4 --codec=h264 --crf=18"
  },
  "dependencies": {
    "@remotion/cli": "4.0.290",
    "@remotion/media-utils": "4.0.290",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290"
  },
  "devDependencies": {
    "@fontsource/amiri": "5.1.0",
    "@fontsource/cinzel": "5.1.0",
    "@fontsource/cormorant-garamond": "5.1.0",
    "@types/react": "18.3.12",
    "typescript": "5.6.3",
    "tsx": "4.19.2"
  }
}